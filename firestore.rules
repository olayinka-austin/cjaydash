rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User root document and profile settings
    match /users/{userId} {
      allow read, write: if request.auth == null || request.auth.uid == userId;

      // Subcollections for each of the 10 investment classes + vault documents
      match /{subcollection}/{docId} {
        allow read, write: if request.auth == null || request.auth.uid == userId;
      }
    }

    // Explicit block for any non-user top level collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
